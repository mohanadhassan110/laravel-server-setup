# Normalize line endings across platforms; shell scripts must always be LF
# or bash will refuse to execute them ("bad interpreter" errors).
* text=auto
*.sh text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
